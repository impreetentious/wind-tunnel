{
  "name": "wind-tunnel",
  "version": "0.25.0",
  "private": true,
  "description": "Client-side SaaS pricing and packaging decision studio.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run privacy && next build && npm run bundle-size",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:conjoint": "vitest run --config vitest.perf.config.ts",
    "e2e": "playwright test",
    "privacy": "node scripts/check-runtime-privacy.mjs",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "web-vitals": "node scripts/check-web-vitals.mjs && playwright test e2e/web-vitals.spec.ts --project=chromium",
    "coverage": "vitest run --coverage",
    "spec-coverage": "node scripts/spec-coverage.mjs",
    "check:version": "node scripts/check-version-coherence.mjs",
    "check:citations": "node scripts/check-citations.mjs"
  },
  "dependencies": {
    "lz-string": "1.5.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.3.6",
    "zundo": "2.3.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "fast-check": "4.7.0",
    "jsdom": "29.0.2",
    "postcss": "8.5.10",
    "prettier": "3.8.3",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "overrides": {
    "postcss": "8.5.10",
    "brace-expansion": "~5.0.5",
    "minimatch@3": {
      "brace-expansion": "~1.1.14"
    },
    "undici": "^7.25.0",
    "next": {
      "sharp": "^0.34.5"
    }
  },
  "engines": {
    "node": "24.15.0",
    "npm": ">=10.0.0"
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/wind-tunnel.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/wind-tunnel/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/wind-tunnel#readme"
}
