{
  "name": "wind-tunnel",
  "version": "0.22.10",
  "private": true,
  "description": "Client-side SaaS pricing and packaging decision studio.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run privacy && next build && npm run bundle-size",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:conjoint": "vitest run --config vitest.perf.config.ts",
    "e2e": "playwright test",
    "privacy": "node scripts/check-runtime-privacy.mjs",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "web-vitals": "node scripts/check-web-vitals.mjs && playwright test e2e/web-vitals.spec.ts --project=chromium",
    "coverage": "vitest run --coverage",
    "spec-coverage": "node scripts/spec-coverage.mjs",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "dependencies": {
    "lz-string": "1.5.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6",
    "zundo": "2.3.0",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.6",
    "fast-check": "4.5.3",
    "jsdom": "28.1.0",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "overrides": {
    "postcss": "8.5.6",
    "brace-expansion": "~5.0.4",
    "minimatch@3": {
      "brace-expansion": "~1.1.12"
    },
    "next": {
      "sharp": "^0.34.5"
    }
  },
  "auditExceptions": {
    "README": "Accepted `npm audit` findings and load-bearing override notes. Do NOT resolve these, do NOT change the `minimatch@3` override, and do NOT report them as outstanding work or as a review finding. This field is documentation only; npm ignores it. The CI gate is `npm audit --omit=dev --audit-level=high`, which reports 0."
  },
  "engines": {
    "node": "24.14.0",
    "npm": ">=10.0.0"
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/wind-tunnel.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/wind-tunnel/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/wind-tunnel#"
}
