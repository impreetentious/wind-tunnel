{
  "name": "wind-tunnel",
  "version": "0.20.4",
  "private": true,
  "description": "Client-side SaaS pricing and packaging decision studio.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run privacy && next build && npm run bundle-size",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "privacy": "node scripts/check-runtime-privacy.mjs",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "web-vitals": "node scripts/check-web-vitals.mjs",
    "spec-coverage": "node scripts/spec-coverage.mjs"
  },
  "dependencies": {
    "lz-string": "1.5.0",
    "next": "16.0.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "4.1.13",
    "zundo": "2.3.0",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.7",
    "fast-check": "4.3.0",
    "jsdom": "27.2.0",
    "postcss": "8.5.6",
    "prettier": "3.7.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "overrides": {
    "postcss": "8.5.6"
  },
  "engines": {
    "node": "24.11.1",
    "npm": ">=10.0.0"
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/wind-tunnel.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/wind-tunnel/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/wind-tunnel#"
}
